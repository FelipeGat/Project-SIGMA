{
    "name": "sigma/auth",
    "description": "Casca HTTP do Identity Engine — login, logout, selecao de Workspace, resolucao de Context. Release 3B, ver docs/releases/0003b-identity-infrastructure.md.",
    "type": "project",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "sigma/core": "^1.0",
        "sigma/kernel": "^1.0",
        "sigma/event-bus": "^1.0",
        "sigma/identity-engine": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sigma\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sigma\\Auth\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../../packages/core" },
        { "type": "path", "url": "../../packages/kernel" },
        { "type": "path", "url": "../event-bus" },
        { "type": "path", "url": "../../packages/identity-engine" }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
