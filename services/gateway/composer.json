{
    "name": "sigma/gateway",
    "description": "Superficie HTTP publica do SIGMA — health (Release 2), rotas de Mission (5.5) e POST /intents (6B), cada resposta no Envelope do SIGMA Protocol.",
    "type": "project",
    "license": "proprietary",
    "version": "1.2.0",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "sigma/core": "^1.0",
        "sigma/kernel": "^1.0",
        "sigma/event-bus": "^1.0",
        "sigma/identity-engine": "^1.0",
        "sigma/mission-engine": "^1.0",
        "sigma/planner-engine": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sigma\\Gateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sigma\\Gateway\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core"
        },
        {
            "type": "path",
            "url": "../../packages/kernel"
        },
        {
            "type": "path",
            "url": "../event-bus"
        },
        {
            "type": "path",
            "url": "../../packages/identity-engine"
        },
        {
            "type": "path",
            "url": "../../packages/mission-engine"
        },
        {
            "type": "path",
            "url": "../../packages/planner-engine"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
