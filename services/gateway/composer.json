{
    "name": "sigma/gateway",
    "description": "Superficie HTTP publica do SIGMA — tres endpoints de health (Release 2) e as duas rotas de Mission (Release 5.5), cada resposta no Envelope do SIGMA Protocol.",
    "type": "project",
    "license": "proprietary",
    "version": "1.1.0",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "sigma/core": "^1.0",
        "sigma/kernel": "^1.0",
        "sigma/event-bus": "^1.0",
        "sigma/identity-engine": "^1.0",
        "sigma/mission-engine": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sigma\\Gateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sigma\\Gateway\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../../packages/core" },
        { "type": "path", "url": "../../packages/kernel" },
        { "type": "path", "url": "../event-bus" },
        { "type": "path", "url": "../../packages/identity-engine" },
        { "type": "path", "url": "../../packages/mission-engine" }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
