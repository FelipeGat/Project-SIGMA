{
    "name": "sigma/mission-worker",
    "description": "Worker do Mission Engine — sem HTTP. Assina mission.planned (publicado pelo Planner Engine) e cria a Mission correspondente. Release 6B, ver docs/releases/0006b-planner-implementation.md.",
    "type": "project",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "sigma/core": "^1.0",
        "sigma/kernel": "^1.0",
        "sigma/event-bus": "^1.0",
        "sigma/mission-engine": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sigma\\MissionWorker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sigma\\MissionWorker\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../../packages/core" },
        { "type": "path", "url": "../../packages/kernel" },
        { "type": "path", "url": "../event-bus" },
        { "type": "path", "url": "../../packages/mission-engine" }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
