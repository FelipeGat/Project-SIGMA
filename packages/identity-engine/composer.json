{
    "name": "sigma/identity-engine",
    "description": "Identity Engine do SIGMA — responde 'quem'. Domain (Release 3A) + Application/Infrastructure/Interface (Release 3B) — ver ADR-0060, ADR-0061.",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "sigma/core": "^1.0",
        "sigma/kernel": "^1.0",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sigma\\IdentityEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sigma\\IdentityEngine\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../kernel"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
