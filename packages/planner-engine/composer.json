{
    "name": "sigma/planner-engine",
    "description": "Planner Engine do SIGMA — decide o Plan de execucao a partir de uma Intent. O unico lugar do sistema onde essa decisao acontece (ADR-0012). Sem estado, sem persistencia (ADR-0095) — tres camadas DDD, nao quatro.",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "sigma/core": "^1.0",
        "sigma/kernel": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sigma\\PlannerEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sigma\\PlannerEngine\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../kernel"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
