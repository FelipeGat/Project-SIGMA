{
    "name": "sigma/mission-engine",
    "description": "Mission Engine do SIGMA — responde 'o que deve acontecer, quem executa, quando'. Domain (Release 5B) — ver ADR-0060, ADR-0061, MISSION_MODEL.md.",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "sigma/core": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sigma\\MissionEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sigma\\MissionEngine\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
