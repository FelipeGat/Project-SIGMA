{
    "name": "sigma/kernel",
    "description": "Bootstrap do SIGMA: DI Container, Module Loader, Configuration Provider, Lifecycle Manager, Health Manager, System Manifest Loader. Expoe apenas interfaces (ver ADR-0052) — nunca conhece Engine (ADR-0040).",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "sigma/core": "^1.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sigma\\Kernel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sigma\\Kernel\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
