{
  "name": "calendar",
  "version": "0.1.0",
  "skill": "GoogleCalendarSkill",
  "config": {
    "required": ["oauth_credentials", "calendarios_permitidos"],
    "optional": []
  },
  "permissions": [
    { "key": "calendar.eventos.ler", "risk": "read" },
    { "key": "calendar.eventos.criar", "risk": "write-external" },
    { "key": "calendar.eventos.atualizar", "risk": "write-external" },
    { "key": "calendar.eventos.cancelar", "risk": "write-external" }
  ],
  "events": [
    "calendar_skill.invoked",
    "calendar_skill.succeeded",
    "calendar_skill.failed",
    "meeting.scheduled"
  ],
  "capabilities": [
    { "name": "CreateEvent", "input": "CreateEventInput", "output": "Meeting", "autonomy_level_required": 2, "events_emitted": ["meeting.scheduled"] },
    { "name": "CancelEvent", "input": "CancelEventInput", "output": "Meeting", "autonomy_level_required": 1, "events_emitted": [] },
    { "name": "MoveEvent", "input": "MoveEventInput", "output": "Meeting", "autonomy_level_required": 1, "events_emitted": [] },
    { "name": "SearchAgenda", "input": "SearchAgendaInput", "output": "Meeting[]", "autonomy_level_required": 3, "events_emitted": [] }
  ]
}
