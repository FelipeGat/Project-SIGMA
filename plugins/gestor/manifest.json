{
  "name": "gestor",
  "version": "0.1.0",
  "skill": "GestorSkill",
  "config": {
    "required": ["api_base_url", "api_token", "empresa_ids"],
    "optional": ["timeout_ms"]
  },
  "permissions": [
    { "key": "gestor.clientes.ler", "risk": "read" },
    { "key": "gestor.orcamentos.ler", "risk": "read" },
    { "key": "gestor.funil.ler", "risk": "read" },
    { "key": "gestor.orcamentos.criar", "risk": "write-internal" },
    { "key": "gestor.funil.atualizar", "risk": "write-internal" }
  ],
  "events": [
    "gestor_skill.invoked",
    "gestor_skill.succeeded",
    "gestor_skill.failed",
    "budget.created_via_gestor"
  ],
  "capabilities": [
    { "name": "FindClient", "version": "1.0.0", "owner": "gestor-plugin", "input": "FindClientInput", "output": "Client", "autonomy_level_required": 3, "events_emitted": [], "dependencies": [] },
    { "name": "CreateBudget", "version": "1.0.0", "owner": "gestor-plugin", "input": "CreateBudgetInput", "output": "Budget", "autonomy_level_required": 1, "events_emitted": ["budget.created_via_gestor"], "dependencies": ["FindClient"] }
  ]
}
